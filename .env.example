# Template only — never put real keys here (this file is committed).
# Copy to .env.local for local dev. On Vercel, set these under Project → Settings → Environment Variables.

# Secret that seals proofs and gates. 32+ random characters, e.g. `openssl rand -base64 48`.
PROOF_SECRET=

# Server-side Solana RPC, e.g. https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
SOLANA_RPC_URL=

# $PRHL mint address, once the token is live.
PROOF_MINT=

# Telegram bot (optional): token from @BotFather. Also connect a private Vercel Blob store (adds BLOB_READ_WRITE_TOKEN).
TELEGRAM_BOT_TOKEN=

# Discord bot (optional): from the Discord Developer Portal.
DISCORD_APP_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=

# $PRHL gate fee (after launch): amount in $PRHL, treasury wallet, burned share in basis points (5000 = 50%).
GATE_FEE=
TREASURY_WALLET=
GATE_FEE_BURN_BPS=5000
