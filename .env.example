# Copy to .env.local for local dev. On Vercel, set these under Project → Settings → Environment Variables.

# Secret used to seal demo proofs. Use a long random string in production.
PROOF_SECRET=

# Optional: server-side Solana RPC (e.g. a Helius RPC URL with your key). Defaults to the public mainnet RPC.
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=b8f874a4-5d80-4b02-9e5d-0f255bf6dc6f
